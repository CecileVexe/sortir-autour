# ─────────────────────────────────────────────────────────────────────────────
# Sortir Autour — variables d'environnement
# Copie ce fichier en `.env.local` (jamais commité) et renseigne tes valeurs.
# Sur Vercel : Project → Settings → Environment Variables.
# Aucune de ces variables n'est envoyée au navigateur (pas de préfixe NEXT_PUBLIC_).
# ─────────────────────────────────────────────────────────────────────────────

# ── Sources de données ───────────────────────────────────────────────────────
# DATAtourisme (offices de tourisme) — clé gratuite : https://www.datatourisme.fr/utiliser-les-donnees/
# Sans clé, la source est désactivée (signalée dans l'interface).
DATATOURISME_API_KEY=

# OpenAgenda (événements) — clé de lecture gratuite : compte openagenda.com → Paramètres → Clé API
OPENAGENDA_API_KEY=

# Activer / désactiver chaque source sans toucher au code (true par défaut)
PROVIDER_DATATOURISME_ENABLED=true
PROVIDER_OSM_ENABLED=true
PROVIDER_OPENAGENDA_ENABLED=true

# Instances Overpass (OpenStreetMap), séparées par des virgules. Laisser vide = valeurs par défaut.
OVERPASS_URLS=

# Contact mis dans le User-Agent envoyé à OpenStreetMap / Wikidata (exigé par leurs règles d'usage).
# Ex. l'URL de ton dépôt GitHub ou une adresse e-mail de contact.
APP_CONTACT=

# Données FICTIVES de démonstration (développement uniquement, ignoré en production)
DEMO_DATA=false

# ── Cache partagé et limitation de débit (facultatif mais recommandé) ────────
# Upstash Redis, offre gratuite : https://console.upstash.com → Create database → onglet « REST API ».
# Sans ces variables : cache et limitation en mémoire, par instance (protection partielle).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Nombre de recherches / de requêtes de géocodage par minute et par visiteur
SEARCH_RATE_LIMIT_PER_MIN=20
GEOCODE_RATE_LIMIT_PER_MIN=90

# ── IA (facultatif) ──────────────────────────────────────────────────────────
# none = aucune IA (l'application reste complète) ; groq = fournisseur Groq
AI_PROVIDER=none
# Clé Groq : https://console.groq.com/keys
GROQ_API_KEY=
# Modèle Groq (Groq retire régulièrement des modèles : vérifier https://console.groq.com/docs/models)
GROQ_MODEL=openai/gpt-oss-20b
# Plafonds côté site : appels IA par jour (tous visiteurs), par visiteur et par heure, taille max du texte
AI_DAILY_LIMIT=200
AI_PER_USER_PER_HOUR=15
AI_MAX_INPUT_CHARS=500

# Niveau de journalisation : debug | info | warn | error
LOG_LEVEL=info
